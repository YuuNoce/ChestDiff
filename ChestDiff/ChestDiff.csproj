<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.0.1</Version>
    <Author>YuuNoce</Author>
    <Name>ChestDiff</Name>
    <Punchline>Summarize Free Company chest history by item and actor.</Punchline>
    <Description>ChestDiff reads the visible Free Company chest history, filters rows after a configured date/time, and summarizes deposits and withdrawals by item and actor.

Commands:
/chestdiff - Open ChestDiff.
/chestdiff export - Export a summary CSV.
/chestdiff dump - Export raw FC chest history text to CSV.
/chestdiff help - Show command help.</Description>
    <Tags>inventory;freecompany;csv</Tags>
  </PropertyGroup>
</Project>
